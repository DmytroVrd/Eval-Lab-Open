# App
APP_MODULE=app.main:app
APP_HOST=0.0.0.0
APP_PORT=8000
HOST_PORT=8000
APP_NAME=AI Eval Lab

# Local/free mode. When true and keys are empty, target and judge calls use
# deterministic local mocks, so the project costs nothing to run.
LOCAL_MOCK_WITHOUT_KEYS=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/eval_lab.db
POSTGRES_DB=eval_lab
POSTGRES_USER=eval_lab
POSTGRES_PASSWORD=eval_lab
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenRouter target model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
DEFAULT_TARGET_MODEL=openrouter/free

# Judge model. Use DEFAULT_JUDGE_PROVIDER=openrouter with a free OpenRouter
# model for no-credit experiments, or anthropic when you have an Anthropic key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEFAULT_JUDGE_PROVIDER=openrouter
DEFAULT_JUDGE_MODEL=openrouter/free

# Eval runtime
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENCY=2
PASS_THRESHOLD=0.7
