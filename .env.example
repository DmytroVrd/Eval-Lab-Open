# App
APP_MODULE=app.main:app
APP_HOST=0.0.0.0
APP_PORT=8000
HOST_PORT=8000
APP_NAME=AI Eval Lab

# Local/free mode. When true and keys are empty, target and judge calls use
# deterministic local mocks, so the project costs nothing to run.
LOCAL_MOCK_WITHOUT_KEYS=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/eval_lab.db
POSTGRES_DB=eval_lab
POSTGRES_USER=eval_lab
POSTGRES_PASSWORD=eval_lab
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Provider keys and target model. Use provider prefixes in model names:
# openrouter/<model>, gemini/<model>, groq/<model>, or mock/target.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_TARGET_MODEL=openrouter/free

# Judge model. Judges currently support OpenRouter, Anthropic, or mock mode.
# Gemini and Groq are direct target providers via DEFAULT_TARGET_MODEL.
# Free tiers can still have rate limits and may call external APIs when keys
# are present and LOCAL_MOCK_WITHOUT_KEYS=false.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEFAULT_JUDGE_PROVIDER=groq
DEFAULT_JUDGE_MODEL=groq/llama-3.3-70b-versatile

# Eval runtime
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENCY=2
PASS_THRESHOLD=0.7
OPENROUTER_MIN_INTERVAL_SECONDS=3.2
GEMINI_MIN_INTERVAL_SECONDS=15.5
GROQ_MIN_INTERVAL_SECONDS=1.0
FALLBACK_TO_MOCK_JUDGE_ON_ERROR=true
SEED_DEMO_DATA=true
